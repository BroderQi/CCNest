<UserControl x:Class="CCNest.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:CCNest.App.ViewModels">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />

            <TextBlock Text="界面" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Text="主题" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Theme}" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="关闭窗口时" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <RadioButton GroupName="close" Content="每次询问（推荐）" IsChecked="{Binding CloseAction, Converter={StaticResource EnumEquals}, ConverterParameter=Ask}" Margin="0,2" />
                    <RadioButton GroupName="close" Content="最小化到通知区域，保持保护" IsChecked="{Binding CloseAction, Converter={StaticResource EnumEquals}, ConverterParameter=MinimizeToTray}" Margin="0,2" />
                    <RadioButton GroupName="close" Content="结束会话、恢复原始设置并退出" IsChecked="{Binding CloseAction, Converter={StaticResource EnumEquals}, ConverterParameter=ExitAndRestore}" Margin="0,2" />
                    <CheckBox Content="激活前不再显示更改预览" IsChecked="{Binding SkipPreview}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="监控" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="线路健康检查间隔（秒）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding HealthInterval, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="出口 IP 核对间隔（秒）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding ExitInterval, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="判定中断的连续失败次数" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding FailureThreshold, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="高级" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Text="CCNest 本地代理端口" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding MixedPort, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="专属浏览器、Claude Code 与系统代理都指向这个端口，建议保持固定。" />
                    <TextBlock Text="自定义 mihomo.exe 路径（留空使用内置版本）" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding MihomoPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="内置 mihomo" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="自定义内核仅用于标准 / 应用强制模式；全局 TUN 模式只会以管理员权限运行通过完整性校验的内置内核。" />
                    <ui:Button Appearance="Primary" Content="保存" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/ccnest-64.png" Width="40" Height="40" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="CCNest " /><Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="Claude 环境管家 · 本地运行，不收集任何数据" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0">
                        <Run Text="代理内核：" /><Run Text="{Binding CoreInfo, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0">
                        <Run Text="数据目录：" /><Run Text="{Binding DataDir, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" LineHeight="19"
                               Text="请仅在 Claude 服务支持的国家和地区、并遵守 Anthropic 使用条款的前提下使用。CCNest 用于管理你已获授权的网络连接、防止路由错误，不用于、也不会帮助绕过任何账号限制、地区资格要求或平台风控。" />
                    <TextBlock Text="软件更新" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Updates.SourceDescription, Mode=OneWay}" Style="{StaticResource Caption}" />
                    <CheckBox Content="自动检查新版本（启动时及每 12 小时）" IsChecked="{Binding AutoCheckUpdates}" Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Content="检查更新" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding Updates.CheckCommand}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Primary" Content="{Binding Updates.InstallButtonText}" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding Updates.InstallCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="查看发布页" Icon="{ui:SymbolIcon Open24}" Command="{Binding Updates.OpenReleasePageCommand}" />
                    </WrapPanel>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Updates.Progress, Mode=OneWay}" Height="4" Margin="0,8,0,0"
                                 Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding Updates.Status, Converter={StaticResource NullToCollapsed}}" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="打开数据目录" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="第三方组件许可" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLicensesCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
