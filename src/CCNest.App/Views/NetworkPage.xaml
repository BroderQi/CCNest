<UserControl x:Class="CCNest.App.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:CCNest.App.ViewModels"
             xmlns:proxy="clr-namespace:CCNest.Core.Proxy;assembly=CCNest.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel MaxWidth="1000">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />

                <ui:InfoBar IsOpen="{Binding SessionActive}" IsClosable="False" Severity="Informational"
                            Message="环境正在运行。这里的修改会保存，但要在结束会话并重新激活后才生效。" Margin="0,0,0,10" />

                <!-- ================= First stage ================= -->
                <Border Style="{StaticResource Surface}">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="重新检测" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding DetectCommand}" />
                            <StackPanel>
                                <TextBlock Text="① 一级线路" Style="{StaticResource CardTitle}" FontSize="16" />
                                <TextBlock Text="CCNest 先经过这条线路，再连接你的静态代理。默认复用你正在运行的 Clash / Mihomo，不修改它的任何配置。" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Margin="0,14,0,4">
                            <RadioButton GroupName="first" Content="现有 Clash / Mihomo（推荐）" Margin="0,0,24,6"
                                         IsChecked="{Binding FirstMode, Converter={StaticResource EnumEquals}, ConverterParameter=ClashLocalPort}" />
                            <RadioButton GroupName="first" Content="导入节点到 CCNest" Margin="0,0,24,6"
                                         IsChecked="{Binding FirstMode, Converter={StaticResource EnumEquals}, ConverterParameter=ImportedNode}" />
                            <RadioButton GroupName="first" Content="手动填写代理" Margin="0,0,24,6"
                                         IsChecked="{Binding FirstMode, Converter={StaticResource EnumEquals}, ConverterParameter=ManualProxy}" />
                            <RadioButton GroupName="first" Content="不使用一级线路" Margin="0,0,24,6"
                                         IsChecked="{Binding FirstMode, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                        </WrapPanel>

                        <!-- Clash local port -->
                        <StackPanel Visibility="{Binding FirstMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=ClashLocalPort}">
                            <Border CornerRadius="6" Padding="12,10" Margin="0,6,0,6"
                                    Background="{Binding ClashFound, Converter={StaticResource StatusToBrush}, ConverterParameter=soft}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Router24" Margin="0,0,10,0" Foreground="{Binding ClashFound, Converter={StaticResource StatusToBrush}}" />
                                    <TextBlock Text="{Binding ClashSummary}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Clash.Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Caption}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本地端口" Style="{StaticResource FieldLabel}" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding DetectedPorts}" Text="{Binding LocalPort, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="协议" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{x:Static vm:NetworkViewModel.Protocols}" SelectedItem="{Binding LocalProtocol}" />
                                </StackPanel>
                            </Grid>
                            <Expander Header="高级：锁定一级节点 / 控制接口" Margin="0,12,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="锁定后，会话期间通过 Clash 控制接口把指定策略组固定到某个节点，结束时切回原节点。这样一级出口不会因为自动测速而跳动。" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="策略组" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding GroupNames}" SelectedItem="{Binding LockGroup}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="固定节点（留空表示不锁定）" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding GroupMembers}" SelectedItem="{Binding LockNode}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="控制接口地址（自动检测，可留空）" Style="{StaticResource FieldLabel}" />
                                            <ui:TextBox Text="{Binding ControllerAddress, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="\\.\pipe\verge-mihomo 或 127.0.0.1:9090" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="控制接口密钥（secret）" Style="{StaticResource FieldLabel}" />
                                            <ui:PasswordBox Password="{Binding ControllerSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="通常可从配置文件自动读取" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <!-- Imported node -->
                        <StackPanel Visibility="{Binding FirstMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=ImportedNode}">
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="把一个 Clash 节点（vmess / vless / trojan / ss / hysteria2 等）导入 CCNest 自己的内核使用。之后一级线路不再依赖 Clash 客户端运行，节点凭据用 Windows DPAPI 加密保存。" />
                            <TextBlock Text="{Binding ImportedNodeSummary}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Visibility="{Binding ImportedNodeSummary, Converter={StaticResource NullToCollapsed}}" Foreground="{StaticResource OkBrush}" />
                            <TextBlock Text="从检测到的配置文件中选择节点" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="导入" Margin="8,0,0,0" Command="{Binding ImportFromConfigCommand}" />
                                <ComboBox ItemsSource="{Binding ConfigNodeNames}" SelectedItem="{Binding SelectedConfigNode}" />
                            </DockPanel>
                            <TextBlock Text="或粘贴节点 YAML" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding ImportYaml, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"
                                        FontFamily="{StaticResource MonoFont}" PlaceholderText="name: my-node&#x0a;type: trojan&#x0a;server: example.com&#x0a;port: 443&#x0a;password: ..." />
                            <ui:Button Content="校验并导入" Margin="0,8,0,0" Command="{Binding ImportNodeCommand}" />
                        </StackPanel>

                        <!-- Manual -->
                        <StackPanel Visibility="{Binding FirstMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=ManualProxy}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="代理地址" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="host:port 或 host:port:用户名:密码 或 socks5://user:pass@host:port" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="协议" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{x:Static vm:NetworkViewModel.Protocols}" SelectedItem="{Binding ManualProtocol}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- None -->
                        <ui:InfoBar Margin="0,8,0,0" IsClosable="False" Severity="Warning" IsOpen="True"
                                    Visibility="{Binding FirstMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=None}"
                                    Message="不使用一级线路时，CCNest 直接从本机连接静态代理，静态代理服务商会看到你本机的公网 IP。" />
                    </StackPanel>
                </Border>

                <!-- ================= Second stage ================= -->
                <Border Style="{StaticResource Surface}">
                    <StackPanel>
                        <TextBlock Text="② 二级静态代理" Style="{StaticResource CardTitle}" FontSize="16" />
                        <TextBlock Text="你从服务商处购买的静态住宅 / ISP 代理。使用标准 HTTP 或 SOCKS5 协议，不需要服务商 API。密码使用 Windows DPAPI 加密保存，不写入日志。" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="服务商" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:NetworkViewModel.Providers}" SelectedItem="{Binding Provider}" DisplayMemberPath="Name" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ProviderHint}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </Grid>

                        <TextBlock Text="快速填写：粘贴服务商提供的代理串" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="识别并填入" Margin="8,0,0,0" Command="{Binding ParsePasteCommand}" />
                            <ui:TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如 123.45.67.89:12323:username:password" />
                        </DockPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="协议" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:NetworkViewModel.Protocols}" SelectedItem="{Binding SecondProtocol}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="代理地址（IP 或域名）" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding SecondHost, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="proxy.example.com" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding SecondPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding SecondUser, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                                <ui:PasswordBox Password="{Binding SecondPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="这可能不是固定的静态 IP" Margin="0,10,0,0"
                                    Message="{Binding EndpointWarning}" Visibility="{Binding EndpointWarning, Converter={StaticResource NullToCollapsed}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="期望出口 IP（强烈建议填写）" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="填入检测到的出口" Margin="8,0,0,0" Command="{Binding UseDetectedIpCommand}" />
                                    <ui:TextBox Text="{Binding ExpectedIp, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="服务商为你分配的静态 IP" FontFamily="{StaticResource MonoFont}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= Test ================= -->
                <Border Style="{StaticResource Surface}">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{Binding TestActionText}" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestCommand}" />
                            <StackPanel>
                                <TextBlock Text="③ 测试线路" Style="{StaticResource CardTitle}" FontSize="16" />
                                <TextBlock Text="{Binding TestDescription}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TestSteps}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type proxy:ChainStep}">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" />
                                            <TextBlock Text="{Binding Hint, StringFormat=建议：{0}}" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}"
                                                       Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TestSummary}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Visibility="{Binding TestSummary, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding IntelSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding IntelSummary, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Surface}">
                    <StackPanel>
                        <TextBlock Text="出口 IP 质量检测" Style="{StaticResource CardTitle}" FontSize="16" />
                        <TextBlock Text="{Binding QualityIpText}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                        <TextBlock Text="打开 Scamalytics 对应 IP 的网页，查看 Fraud Score 和风险标签，无需填写 API Key。"
                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <ui:Button Content="查看出口 IP 质量（Scamalytics）" Icon="{ui:SymbolIcon Open24}"
                                   Command="{Binding CheckExitQualityCommand}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding QualityStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding QualityStatus, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- ================= Protection ================= -->
                <Border Style="{StaticResource Surface}">
                    <StackPanel>
                        <TextBlock Text="④ 保护方式" Style="{StaticResource CardTitle}" FontSize="16" />
                        <TextBlock Text="选择 CCNest 在会话期间如何保证 Claude 流量只走二级出口。三种模式的保证程度不同，请按需选择。" Style="{StaticResource Caption}" Margin="0,2,0,10" />

                        <RadioButton GroupName="level" IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Standard}" Margin="0,4">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="标准模式（无需管理员）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="专属浏览器、Claude Code 与遵循系统代理的应用经 CCNest 出网；线路故障时这些应用会断网而不会改走其他出口。不遵循代理的程序不受影响。" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="level" IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=AppEnforced}" Margin="0,4">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="应用强制模式（需要管理员）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="在标准模式基础上，用 Windows 筛选平台（WFP）规则限制 Claude Desktop 与 Claude Code 只能连接 CCNest，任何绕过代理的直连都会被系统拒绝。不影响其他程序。" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="level" IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=SystemTun}" Margin="0,4">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="全局 TUN 模式（需要管理员）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="CCNest 创建虚拟网卡接管整台电脑的流量（含 IPv6 与 DNS），并用 WFP 阻断一切绕过它的连接。现有 Clash 的 TUN 需关闭（可自动临时关闭）。" />
                            </StackPanel>
                        </RadioButton>
                        <CheckBox Content="全局 TUN 模式下，自动临时关闭现有 Clash 客户端的 TUN（结束时恢复）" IsChecked="{Binding DisableExistingTun}" Margin="28,4,0,0"
                                  Visibility="{Binding Level, Converter={StaticResource EnumToVisibility}, ConverterParameter=SystemTun}" />

                        <TextBlock Text="分流范围" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="scope" Content="全部流量走二级出口（推荐）" Margin="0,0,24,0"
                                         IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter=AllTraffic}" />
                            <RadioButton GroupName="scope" Content="仅 Claude 相关域名走二级，其余走一级"
                                         IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter=ClaudeOnly}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Claude 页面会加载少量第三方服务（人机验证、支付、客服组件）。“全部流量”可以保证同一页面始终只有一个出口。" />

                        <TextBlock Text="CCNest 意外退出时（崩溃策略）" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" FontWeight="SemiBold" />
                        <RadioButton GroupName="crash" IsChecked="{Binding CrashPolicy, Converter={StaticResource EnumEquals}, ConverterParameter=KeepBlocked}" Margin="0,2">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="安全优先：保持阻断，等待我处理" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="Claude 流量会中断而不是改走其他出口。CCNest 会自动重新打开并提示你恢复；重启电脑会清除阻断规则，但代理设置仍指向已停止的 CCNest（相关应用仍无法联网）。" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="crash" IsChecked="{Binding CrashPolicy, Converter={StaticResource EnumEquals}, ConverterParameter=AutoRestore}" Margin="0,2">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="可用性优先：自动恢复原始网络" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="守护进程立即恢复原始设置，电脑恢复正常上网，但此后的 Claude 流量将不再经过二级出口。" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="监控与验证" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" FontWeight="SemiBold" />
                        <ui:ToggleSwitch Content="出口 IP 与期望不符时立即阻断流量" IsChecked="{Binding BlockOnMismatch}" Margin="0,4" />
                        <ui:ToggleSwitch Content="睡眠唤醒或网络变化后，先复核出口再放行" IsChecked="{Binding Reverify}" Margin="0,4" />
                        <ui:ToggleSwitch Content="激活前必须设置期望出口 IP" IsChecked="{Binding RequireExpectedIp}" Margin="0,4" />
                        <ui:ToggleSwitch Content="允许访问局域网（打印机、NAS 等，全局模式有效）" IsChecked="{Binding AllowLan}" Margin="0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky save bar -->
        <Border Grid.Row="1" Padding="32,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="撤销修改" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Content="保存设置" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource ErrorBrush}" Margin="0,0,6,0"
                                   Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding ValidationError}" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="有未保存的修改" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
