<UserControl x:Class="CCNest.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:CCNest.App.ViewModels"
             x:Name="Root">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />

            <Border Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Pill}" Background="{StaticResource ErrorSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorCount, StringFormat=需处理 {0}}" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource WarnSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource WarnBrush}" Text="{Binding WarningCount, StringFormat=风险 / 注意 {0}}" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource OkSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource OkBrush}" Text="{Binding OkCount, StringFormat=正常 {0}}" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource BrandSoftBrush}">
                                <TextBlock Foreground="{StaticResource BrandBrush}" Text="{Binding RepairableCount, StringFormat=可自动修复 {0}}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox Content="测试双重线路" IsChecked="{Binding IncludeChain}" Margin="0,0,18,0" />
                            <CheckBox Content="DNS 泄漏检测（使用第三方服务 bash.ws）" IsChecked="{Binding IncludeDnsLeak}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <ui:Button Appearance="Primary" Content="开始检测" Icon="{ui:SymbolIcon Stethoscope24}" Command="{Binding RunCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="自动包含专属浏览器检测" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button Content="复制报告" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyReportCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="导出" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ExportReportCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Text="环境一致性评分" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConsistencyScore}" FontSize="30" FontWeight="Bold" Margin="0,8,0,4"
                               Foreground="{Binding ConsistencyStatus, Converter={StaticResource StatusToBrush}}" />
                    <TextBlock Text="{Binding ConsistencySummary}" Style="{StaticResource Body}"
                               Foreground="{Binding ConsistencyStatus, Converter={StaticResource StatusToBrush}}" />
                    <TextBlock Text="全部一致为 100 分；不一致逐项扣分；待检测项目暂不计分。该评分只衡量你的环境一致性，IP 数据源的风险分数另列。"
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding BrowserCheckStatus}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                       Visibility="{Binding BrowserCheckStatus, Converter={StaticResource NullToCollapsed}}" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiagnosticGroup}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Surface}" Padding="0">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DiagnosticItemViewModel}">
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                <StackPanel Margin="18,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True" FontSize="18" VerticalAlignment="Top"
                                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detected}" Style="{StaticResource Body}" LineHeight="20" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <ui:Button Appearance="Primary" Content="{Binding Repair.Title}" Icon="{ui:SymbolIcon Wrench24}" Margin="0,0,8,0"
                                                                       Command="{Binding DataContext.RepairCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                       Visibility="{Binding Repair, Converter={StaticResource NullToCollapsed}}" />
                                                            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ChevronDown24}" ToolTip="详情"
                                                                       Command="{Binding DataContext.ToggleExpandCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Margin="218,8,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" Opacity="0.85" Margin="0,0,0,6"
                                                                   Visibility="{Binding Explanation, Converter={StaticResource EmptyToCollapsed}}" />
                                                        <ItemsControl ItemsSource="{Binding Details}" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="170" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Mono}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Grid Margin="0,6,0,0" Visibility="{Binding ManualSteps, Converter={StaticResource NullToCollapsed}}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Symbol="Person24" FontSize="14" Margin="0,0,6,0" Foreground="{StaticResource WarnBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ManualSteps, StringFormat=需要手动处理：{0}}" Style="{StaticResource Body}" Foreground="{StaticResource WarnBrush}" />
                                                        </Grid>
                                                        <Grid Margin="0,6,0,0" Visibility="{Binding Uncertainty, Converter={StaticResource NullToCollapsed}}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="14" Margin="0,0,6,0" Opacity="0.7" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Uncertainty, StringFormat=不确定性：{0}}" Style="{StaticResource Caption}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding RepairResult}" Style="{StaticResource Body}" Foreground="{StaticResource OkBrush}" Margin="0,6,0,0"
                                                                   Visibility="{Binding RepairResult, Converter={StaticResource NullToCollapsed}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Surface}" Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVisibility}}" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Stethoscope24" FontSize="40" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="点击“开始检测”，CCNest 会检查约 20 个项目，通常需要 20–40 秒。" Style="{StaticResource Body}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="检测只读取信息，不会修改任何设置；可修复的问题会单独列出，确认后才会处理。" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
