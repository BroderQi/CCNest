<UserControl x:Class="CCNest.App.Views.BrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:CCNest.App.ViewModels">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />

            <Border Style="{StaticResource Surface}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource BrandSoftBrush}" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Window24" FontSize="28" Foreground="{StaticResource BrandBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0">
                        <TextBlock Text="Claude专属浏览器" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                            <Run Text="资料大小：" /><Run Text="{Binding SizeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Info.UserDataDir}" Style="{StaticResource Mono}" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ui:Button Style="{StaticResource HeroButton}" Appearance="Primary" Content="打开专属浏览器" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenCommand}" />
                        <ui:Button Content="创建桌面快捷方式" Icon="{ui:SymbolIcon Add24}" Command="{Binding CreateShortcutCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="浏览器与语言" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Text="使用的浏览器" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Name" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="专属资料使用独立的用户数据目录，与浏览器本身的日常资料互不影响；浏览器程序本身照常自动更新。Chrome 与 Edge 的资料各自独立保存，切换后原资料仍保留。" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="网页语言偏好（Accept-Language）" Style="{StaticResource FieldLabel}" />
                            <ComboBox IsEditable="True" ItemsSource="{x:Static vm:BrowserViewModel.LanguagePresets}" Text="{Binding AcceptLanguages, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="浏览器界面语言" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding UiLanguage, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="en-US" />
                        </StackPanel>
                    </Grid>
                    <ui:ToggleSwitch Margin="0,12,0,0" IsChecked="{Binding RestrictWebRtc}"
                                     Content="限制 WebRTC 只通过代理（禁用非代理 UDP，Chrome 内置的隐私选项，推荐开启）" />
                    <ui:Button Content="保存语言与隐私设置" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveLanguageCommand}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="资料管理" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" LineHeight="20"
                               Text="专属资料永久保存在你的用户目录中：CCNest 升级、重装、激活或恢复网络都不会删除它。CCNest 不做任何指纹伪装——浏览器的版本、字体、显卡等特征来自你的电脑本身，网络出口来自 CCNest 线路。" />
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="打开资料文件夹" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="重置专属资料…" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding ResetCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="重置不会删除数据，而是把当前资料移动到 archived-日期 文件夹，需要时可以手动恢复。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
