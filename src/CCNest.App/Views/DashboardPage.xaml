<UserControl x:Class="CCNest.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:CCNest.App.ViewModels"
             xmlns:session="clr-namespace:CCNest.Core.Session;assembly=CCNest.Core">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Subtitle}" />

            <!-- Setup readiness: lists exactly what still blocks activation -->
            <Border Style="{StaticResource Surface}" Background="{StaticResource BrandSoftBrush}" BorderBrush="{StaticResource BrandBrush}"
                    Visibility="{Binding ShowSetupBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="去网络线路" Icon="{ui:SymbolIcon ArrowRight24}"
                               Command="{Binding GoCommand}" CommandParameter="network" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding SetupTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding SetupMissing}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Windows settings applied separately are still changed after the session ended -->
            <Border Style="{StaticResource Surface}" Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}"
                    Visibility="{Binding ShowStandaloneBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="恢复这些设置" Icon="{ui:SymbolIcon ArrowUndo24}"
                               Command="{Binding RestoreStandaloneCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Windows 设置尚未恢复" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding StandaloneText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hero status -->
            <Border Style="{StaticResource Surface}" Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top"
                            Background="{Binding Status.State, Converter={StaticResource StatusToBrush}, ConverterParameter=soft}">
                        <ui:SymbolIcon Symbol="{Binding Status.State, Converter={StaticResource StatusToSymbol}}" FontSize="32" Filled="True"
                                       Foreground="{Binding Status.State, Converter={StaticResource StatusToBrush}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,2,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StateLabel}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{Binding Status.State, Converter={StaticResource StatusToBrush}}" />
                            <TextBlock Text="{Binding SinceText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="12,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status.Detail}" Style="{StaticResource Body}" Margin="0,6,0,0" LineHeight="20" />
                        <TextBlock Text="{Binding IntelText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding IntelText, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource HeroButton}" Appearance="Primary" Content="激活 Claude 环境"
                                   Icon="{ui:SymbolIcon Power24}" Command="{Binding ActivateCommand}"
                                   Visibility="{Binding IsInactive, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Style="{StaticResource HeroButton}" Appearance="Secondary" Content="结束并恢复原始设置"
                                   Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding DeactivateCommand}"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" HorizontalAlignment="Center"
                                         Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics -->
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource Surface}" Margin="0,0,8,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="当前出口 IP" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Status.ExitIp, TargetNullValue=—}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Surface}" Margin="4,0,4,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="期望出口 IP" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ExpectedIpText, TargetNullValue=未设置}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Surface}" Margin="4,0,4,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="线路延迟" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LatencyText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Surface}" Margin="8,0,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="入口闸门" Style="{StaticResource Caption}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="关闭" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.GateOpen}" Value="True">
                                            <Setter Property="Text" Value="开启" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Exit mismatch actions -->
            <ui:InfoBar IsOpen="{Binding HasMismatch}" IsClosable="False" Severity="Warning" Title="出口 IP 与期望不符，流量已阻断"
                        Message="CCNest 不会在出口变化时继续放行流量。若服务商确实更换了 IP，可以接受新 IP；否则请检查二级代理配置。" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Content="重新验证出口" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ReverifyCommand}" Margin="0,0,8,0" />
                <ui:Button Content="接受新的出口 IP" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding AcceptNewIpCommand}"
                           Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Status.Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding}" Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Activation steps -->
            <Border Style="{StaticResource Surface}" Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="激活过程" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type session:ActivationStep}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource StatusToSymbol}}" Filled="True"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Body}" Opacity="0.85" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar IsOpen="True" IsClosable="True" Severity="Informational" Message="{Binding}" Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick actions -->
            <TextBlock Text="常用操作" Style="{StaticResource SectionTitle}" />
            <UniformGrid Columns="4">
                <ui:CardAction Icon="{ui:SymbolIcon Window24}" Command="{Binding OpenBrowserCommand}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="打开专属浏览器" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Claude 专属资料，长期保留登录" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon Code24}" Command="{Binding OpenClaudeTerminalCommand}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Claude Code 终端" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="已预设专属线路代理的终端" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon Bot24}" Command="{Binding LaunchDesktopCommand}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="启动 Claude Desktop" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="附带专属线路代理参数" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon Stethoscope24}" Command="{Binding GoCommand}" CommandParameter="diagnostics" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="环境检测" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="排查线路、DNS 与配置问题" Style="{StaticResource Caption}" />
                    </StackPanel>
                </ui:CardAction>
            </UniformGrid>

            <!-- Route -->
            <TextBlock Text="线路" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="一级线路" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FirstStageText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Status.FirstStageExitIp, StringFormat=一级出口 {0}}" Style="{StaticResource Caption}"
                                   Visibility="{Binding Status.FirstStageExitIp, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" Margin="16,0" Foreground="{StaticResource BrandBrush}" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="二级静态代理" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding SecondStageText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="3" Symbol="ArrowRight24" Margin="16,0" Foreground="{StaticResource BrandBrush}" />
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="保护方式" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ui:HyperlinkButton Content="修改线路配置" Command="{Binding GoCommand}" CommandParameter="network" Padding="0,4" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Protection scope -->
            <TextBlock Text="保护范围（当前配置下实际能保证什么）" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Surface}" Padding="0">
                <ItemsControl ItemsSource="{Binding Scope}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type session:ProtectionScopeItem}">
                            <Grid Margin="18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" Filled="True"
                                               Foreground="{Binding Enforced, Converter={StaticResource StatusToBrush}}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Info24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enforced}" Value="True">
                                                    <Setter Property="Symbol" Value="ShieldCheckmark24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Target}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Coverage}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Guarantee}" Style="{StaticResource Body}" LineHeight="20" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
